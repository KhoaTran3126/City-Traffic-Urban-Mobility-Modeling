      <column caption='Zone Highlight' datatype='string' name='[Calculation_0090408858705931]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [city_zone] = [Parameters].[Parameter 0090408856797190] THEN&#10;    &quot;Selected&quot;&#10;ELSE&#10;    &quot;Other&quot;&#10;END' />
      </column>
      <column caption='Time Period' datatype='string' name='[Calculation_0090408864145420]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [hour] &gt;= 0      AND [hour] &lt; 6  THEN &quot;Overnight&quot;&#10;ELSEIF [hour] &gt;= 6  AND [hour] &lt; 12 THEN &quot;Morning&quot;&#10;ELSEIF [hour] &gt;= 12 AND [hour] &lt; 17 THEN &quot;Afternoon&quot;&#10;ELSEIF [hour] &gt;= 17 AND [hour] &lt; 21 THEN &quot;Evening&quot;&#10;ELSE &quot;Night&quot;&#10;END' />
      </column>
